class TestCamWidget(QWidget):

    def __init__(self, 
                 front_pipe: connection.Connection,
                 display_buffer: RingBuffer,
                 width,
                 height,
                 *args, 
                 **kwargs):
        super().__init__(*args, **kwargs)

        self.front_pipe = front_pipe
        self.display_buffer = display_buffer
        self.width = width
        self.height = height
        self.worker = None

        self.declare_components()
        self.layout_components()

    def declare_components(self):
        self.start_button = QPushButton(self)
        self.start_button.setText('start')
        self.start_button.clicked.connect(self.start_acquisition)

        self.stop_button = QPushButton(self)
        self.stop_button.setText('stop')
        self.stop_button.clicked.connect(self.stop_acquisition)

        self.terminate_button = QPushButton(self)
        self.terminate_button.setText('terminate')
        self.terminate_button.clicked.connect(self.terminate)

        self.camera_preview = QLabel(self)
        self.camera_preview.setFixedSize(self.width, self.height)

    def layout_components(self):
        layout_start_stop = QHBoxLayout()
        layout_start_stop.addWidget(self.start_button)
        layout_start_stop.addWidget(self.stop_button)
        layout_start_stop.addWidget(self.terminate_button)
        layout_start_stop.addStretch()

        layout = QVBoxLayout()
        layout.addWidget(self.camera_preview)
        layout.addLayout(layout_start_stop)

        self.setLayout(layout)


### Callbacks
    def start_acquisition(self):
        self.front_pipe.send('start')
        print('Main process sent start command')
        self.worker = TestSender(self.display_buffer)
        self.worker.frameReady.connect(self.update_preview)
        self.qthread = QThread()
        self.worker.moveToThread(self.qthread)
        self.qthread.started.connect(self.worker.run)
        self.qthread.start()
    
    def stop_acquisition(self):
        self.front_pipe.send('stop')
        time.sleep(1)
        if self.worker:
            self.worker.terminate()
            self.qthread.quit()

    def terminate(self):
        self.front_pipe.send('terminate')
    
    def update_preview(self):
        self.camera_preview.setPixmap(NDarray_to_QPixmap(self.worker.frame))


class TestCamWorker:
    def __init__(self, 
                 display_buffer: RingBuffer, 
                 camera: Camera, 
                 *args,
                 **kwargs):
        super().__init__(*args, **kwargs)

        self.display_buffer = display_buffer
        self.camera = camera
        self.active = True
        self.acquisition_started = False
        self.is_waiting = threading.Event()
        self.is_waiting.set()
    
    def start_acquisition(self):
        self.camera.start_acquisition()
        self.acquisition_started = True
        self.is_waiting.set()
    
    def stop_acquisition(self):
        self.acquisition_started = False
        self.camera.stop_acquisition()
        self.is_waiting.clear()

    def terminate(self):
        self.active = False

    def run(self):
        while self.active:
            self.is_waiting.wait()
            if self.acquisition_started:
                frame = self.camera.get_frame()
                if frame.image is not None:
                    self.display_buffer.put(frame.image)

class TestCamProcess(Process):
    def __init__(self, 
                 back_pipe: connection.Connection, #because Pipe is not a type but a function
                 display_buffer: RingBuffer,
                 camera_constructor: Callable[[int], Camera],
                 *args, 
                 **kwargs):
        super().__init__(*args, **kwargs)

        self.back_pipe = back_pipe
        self.display_buffer = display_buffer
        self.camera_constructor = camera_constructor
        self.active = True
        self.test_worker = None

    # add some init method and cleanup method for before and after while loop 
    def init_cam(self):
        self.camera = self.camera_constructor()

    # def release_cam(self):
    
    def run(self):
        print('CamProcess started')
        self.init_cam()
        while self.active: 
            msg = self.back_pipe.recv()
            if msg == 'start':
                print('CamProcess received start command')
                if self.test_worker is None:
                    self.test_worker = TestCamWorker(self.display_buffer, self.camera)
                    self.thread = Thread(target=self.test_worker.run)
                    self.thread.start()
                self.test_worker.start_acquisition()
                
            elif msg == 'stop' and self.test_worker:
                print('CamProcess received stop message')
                self.test_worker.stop_acquisition()
            
            elif msg == 'terminate':
                if self.test_worker:
                    self.test_worker.terminate()
                    self.thread.join()
                self.active = False

    
